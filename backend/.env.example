# AEGIS runtime knobs (optional). Defaults match the SIH 16-band demo.

# Receiver hop interval in milliseconds (20–500). Lower = faster scan.
AEGIS_SWEEP_MS=50

# Hostile spawn multiplier 0–1 for HIGH-threat bands.
AEGIS_HOSTILE_SPAWN=0.55

# Ambient noise / false occupancy 0–0.8 on quiet bands.
AEGIS_NOISE_FLOOR=0.12

# Smart Scan epsilon-greedy exploration 0–0.4 (10% default).
AEGIS_EPSILON=0.10

# Age-of-Information pre-emption threshold.
AEGIS_AOI_MS=850

AEGIS_TELEMETRY_HZ=20
